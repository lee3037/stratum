# Stratum 层析配置示例。
# systemd 部署：复制到 /etc/stratum/stratum.env；直接运行 ./run.sh：复制为项目根目录下的 stratum.env。

HOST=0.0.0.0
PORT=8000

# 文件库根目录：其下每个子目录是一个知识库，PDF 与解析结果都保存在这里。
STRATUM_DATA_DIR=/data/stratum/library
# 解析任务的临时目录（直接上传解析时使用），放在数据盘，不要与文件库目录相同。
STRATUM_WORK_DIR=/data/stratum/work

# 解析进程数与每个进程的 OCR 线程数。每个进程约占 350 MB 内存。
# 112 核服务器建议 16 × 2，约占 32 核，其余留给其他服务。
STRATUM_WORKERS=16
STRATUM_OCR_THREADS=2
# 同时批量解析的文件数（默认 解析进程数 / 6，取 1 至 4）
# STRATUM_BATCH_CONCURRENCY=2

# 单个 PDF 上限（MB）与页数上限
STRATUM_MAX_MB=200
STRATUM_MAX_PAGES=2000

# 同时进行的单个解析上限（默认 解析进程数 × 2，至少 8）；超出时提示稍后再试
# STRATUM_MAX_JOBS=32
# 磁盘剩余空间低于该值（MB）时拒绝上传、保存和打包
# STRATUM_MIN_FREE_MB=2048

# Markdown 中图片链接的地址前缀：使用 FastGPT 的人的浏览器能打开的 Stratum 地址（不要写 127.0.0.1）。
# 不配置时使用浏览器访问 Stratum 的地址。
# STRATUM_PUBLIC_URL=http://192.162.10.41:18080

# FastGPT：不配置时界面不提供导入。配置后运行 deploy/fastgpt_probe.py 检测。
# STRATUM_FASTGPT_URL=http://127.0.0.1:3000
# STRATUM_FASTGPT_API_KEY=fastgpt-xxxxxxxx
# STRATUM_FASTGPT_SPLIT_MODE=char

